# Optional: directory used for generated PNG files.
COMICFORGE_OUTPUT_DIR=outputs

# Optional Gradio launch settings.
COMICFORGE_SERVER_NAME=127.0.0.1
COMICFORGE_SERVER_PORT=7860

# Text-model behavior. Connection and model-generation timeouts are independent.
TEXT_MODEL_CONNECT_TIMEOUT=10
TEXT_MODEL_GENERATION_TIMEOUT=300
# Independent upper bound for optional script review; Demo-friendly default.
TEXT_MODEL_REVIEW_TIMEOUT=90
TEXT_MODEL_STATUS_TIMEOUT=10
TEXT_MODEL_MAX_RETRIES=1
TEXT_MODEL_FALLBACK_TO_MOCK=true
# Release local Ollama weights before a local image Provider uses the same GPU.
RELEASE_TEXT_MODEL_BEFORE_LOCAL_IMAGE=true

# Optional local Ollama provider.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONNECT_TIMEOUT=10
OLLAMA_GENERATION_TIMEOUT=300
OLLAMA_REVIEW_TIMEOUT=90
OLLAMA_NUM_PREDICT=4096
OLLAMA_NUM_CTX=8192

# Optional generic OpenAI-compatible Chat Completions provider.
# Keep credentials only in your local environment or ignored .env file.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# auto disables Qwen3 thinking via /no_think; true/false forces the behavior.
OPENAI_COMPATIBLE_DISABLE_THINKING=auto
OPENAI_COMPATIBLE_REASONING_EFFORT=
OPENAI_COMPATIBLE_MAX_TOKENS=4096

# Image-model behavior. Only failed panels fall back when enabled.
IMAGE_MODEL_CONNECT_TIMEOUT=10
IMAGE_MODEL_GENERATION_TIMEOUT=300
IMAGE_MODEL_MAX_RETRIES=1
IMAGE_MODEL_RETRY_BASE_DELAY=0.5
IMAGE_MODEL_MAX_POLL_SECONDS=300
IMAGE_MODEL_POLL_INTERVAL=1
IMAGE_DOWNLOAD_MAX_BYTES=20971520
IMAGE_PANEL_CONCURRENCY=1
IMAGE_MODEL_FALLBACK_TO_MOCK=true
IMAGE_PROVIDER_FALLBACK_CHAIN=

# Optional generic OpenAI-compatible Images API provider.
# The base URL may be a service root, end in /v1, or be the full endpoint.
OPENAI_IMAGE_BASE_URL=
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_SIZE=1024x1024

# Optional Recraft image Provider.
RECRAFT_API_KEY=
RECRAFT_MODEL=recraftv4_1
RECRAFT_IMAGE_ENDPOINT=https://external.api.recraft.ai/v1/images/generations

# Optional Together AI image Provider.
TOGETHER_API_KEY=
TOGETHER_MODEL=
TOGETHER_IMAGE_ENDPOINT=https://api.together.xyz/v1/images/generations

# Optional SiliconFlow image Provider.
# Use the endpoint that matches the account/Key region; do not mix CN and
# international credentials. Authentication/model-list success is not proof of
# paid image generation, which also requires usable account balance.
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=
SILICONFLOW_IMAGE_ENDPOINT=https://api.siliconflow.cn/v1/images/generations

# Optional fal queue Provider.
FAL_KEY=
FAL_MODEL=
FAL_BASE_URL=https://queue.fal.run

# Optional local ComfyUI Provider using a portable repository-relative API Workflow.
# The checkpoint, IPAdapter custom nodes, and CLIP Vision weights remain in ComfyUI.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=workflows/comfyui_text2img_api.json
COMFYUI_MODEL=animagine-xl-4.0-ipadapter
COMFYUI_PROMPT_NODE_ID=6
COMFYUI_WIDTH_NODE_ID=5
COMFYUI_HEIGHT_NODE_ID=5
COMFYUI_SEED_NODE_ID=3
# Optional. When blank, ComicForge detects the CLIP node connected to KSampler.negative.
COMFYUI_NEGATIVE_PROMPT_NODE_ID=
# Optional. When blank, ComicForge detects LoadImage connected to IPAdapter.image.
COMFYUI_REFERENCE_IMAGE_NODE_ID=

# Reserved for planned P1 Providers; not registered until implemented and tested.
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
REPLICATE_API_TOKEN=
XAI_API_KEY=
